.{
    .name = .anole,
    .version = "0.4.1",
    .fingerprint = 0xe9214b117feef58, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Core, always used, pinned by commit. zio: Anole's fork
        // xuckless/zio, branch `anole`: lalinsky/zio main
        // 035d245 (2026-10-21) merged into the fork. Upstream now carries
        // what used to be fork patches: the pinned overflow queue drained
        // into the ring fully (#841), sendmmsg in sendMany (#833, #843) and
        // the Windows UDP ICMP fix (#849); it also drops the runtime-wide
        // task counter (#842) and re-arms a caller's cancel after
        // waitUntilComplete (#823). Fork patches on top: a push that waits
        // behind the pinned overflow queue (one FIFO order; #841 alone could
        // starve overflowed tasks behind >256 yielding ones), an accept loop that
        // keeps up on a busy executor (direct accept with its own budget,
        // putting back a cancel it finds pending; spawn backpressure every
        // 64 spawns), a spawn cache per executor (stacks and task
        // allocations without the runtime's locks), idle tasks that give
        // back their deeper stack pages (Linux, pinned),
        // Runtime.currentExecutor and zio.currentTask, operateInner arms out
        // of line (smaller I/O wait frames), recvmmsg with control messages,
        // and for Windows, streaming file reads and writes on IOCP's
        // overlapped handles and peer-caused socket errors logged at debug.
        // net.ReadyWatch is gone (Anole parks through CompletionQueue). The
        // HTTP core (adapted from lalinsky/dusty) is in src/http/core, not a
        // dependency.
        // Plus `diagnostics` (88f6d69): comptime-gated per-executor task
        // counters and stack stats for the runtime gauges on /metrics. Plus
        // SAFETY.md's checks: `debug_held_locks` (4a2dd7c), a task that
        // suspends holding a counted lock panics (L2), and a count of
        // `debug_cancel` reports (3accc88, exported in 42f97ae), on which
        // the test runner fails a test (C3), and no report for a cancel an
        // AutoCancel consumed as its timeout (812eac3), and a report hook
        // (`held_locks.report`, baf4e5f) through which src/safety names
        // where each held lock was taken; and `quiescent_state` (c21be0b,
        // fork only): a quiescent-state counter per executor and a
        // grace-period number (`Runtime.quiescentSnapshot`/`quiescentPassed`)
        // for src/http/core/qsbr.zig's reclamation. Pinned on the fork's
        // `anole-diag` branch (c21be0b, `anole` + three commits): in
        // Debug and test builds, `diagnostics` also keeps a live-task list
        // per executor and a registry of runtimes for `zio.dumpTasks`, which
        // the test runner's hang dump prints, and a stall watchdog that
        // reports an executor that stops passing its scheduler while work
        // waits (src/diag.zig in the fork).
        .zio = .{
            .url = "git+https://github.com/xuckless/zio#c21be0b777f847c70b39625f157cced846f06599",
            .hash = "zio-0.19.0-xHbVVL-9LgCBbG9bClmiizWcwMWDrB9H57GaJSp4oZuG",
        },
        // C bindings generator, branch zig-0.17.x (v2.0.2), pinned by commit.
        .translate_c = .{
            .url = "git+https://codeberg.org/ziglang/translate-c?ref=zig-0.17.x#cfac21f3199b2b02ce3fd7db652aa456421fe4ab",
            .hash = "translate_c-2.0.2-Q_BUWvBNBwDnyehSiuAJmdFcMYHYGA-Jc3KiYdrV2Dqx",
            .lazy = true,
        },
        // -Dhttp2: nghttp2 1.70.0 from Anole's fork xuckless/nghttp2, branch
        // `anole`: the v1.70.0 tag plus its generated nghttp2ver.h and a patch
        // that answers frames on closed streams, PRIORITY errors and stream
        // window overflow as RFC 9113 says (h2spec 146/146).
        .nghttp2 = .{
            .url = "https://github.com/xuckless/nghttp2/archive/0f8bc1c4271f4380409071eade31830e6e436bd6.tar.gz",
            .hash = "N-V-__8AAP98WQBOcqCV-jYjCmw19Aw3aCtmPAMilcMGfLOK",
            .lazy = true,
        },
        // -Dtls=boringssl: google/boringssl at 22a0079b, the commit ngtcp2 1.25.0
        // is tested against, built by build/boringssl.zig.
        .boringssl = .{
            .url = "https://github.com/google/boringssl/archive/22a0079b189c391b95689813a41982ce11876f0a.tar.gz",
            .hash = "N-V-__8AAPOrbw7gV-8XeYfUaBxCqpoXGrn_bb_vyzdnkayq",
            .lazy = true,
        },
        // -Dhttp3: ngtcp2 1.25.0 from Anole's fork xuckless/ngtcp2, branch
        // `anole`: the v1.25.0 tag plus its generated version.h and a patch
        // that keeps the connection ID a server falls back to when a client
        // migrates right after a NAT rebinding (stock 1.25.0 retires it and
        // then closes with CONNECTION_ID_LIMIT_ERROR), and one that makes a
        // server PTO in the Initial space retransmit two packets, not one (a
        // post-quantum ServerHello spans two), and one that gives both
        // PATH_CHALLENGE probes of a validation round the same data (peers
        // that answer only the latest challenge then answer the first), and
        // one that makes a server follow a client whose address changes
        // during the handshake (a NAT rebinding) instead of stalling, and
        // one that keeps pacing from sending an ACK to a new path before its
        // PATH_CHALLENGE.
        // Pinned by git URL and commit. nghttp3 1.18.0 from
        // Anole's fork xuckless/nghttp3, branch `anole`: the v1.18.0 tag plus
        // the release's generated version.h and bundled sfparse, and
        // nghttp3_conn_add_extra_setting, which sends the SETTINGS
        // WebTransport needs (0x2b603742 for Chrome and Firefox).
        .ngtcp2 = .{
            .url = "git+https://github.com/xuckless/ngtcp2#b70d6d98d90be1af793af704bdf66b97df8dd7f1",
            .hash = "N-V-__8AAMCuQwCjsxFJ5ddtVQcmqA7wQVrluqzivC1f7D72",
            .lazy = true,
        },
        // -Dcompression: zlib-ng 2.3.3 (zlib-compat, runtime SIMD dispatch) and
        // zstd 1.5.7, built by build/zlib_ng.zig and build/zstd.zig; and
        // lalinsky/zlib.zig (the commit dusty pins) for its std.Io wrapper,
        // src/root.zig only.
        .zlib_ng = .{
            .url = "https://github.com/zlib-ng/zlib-ng/archive/refs/tags/2.3.3.tar.gz",
            .hash = "N-V-__8AAPaJcABkB6U-96R7h2xuXX5TlDMvwPbE4PucPI59",
            .lazy = true,
        },
        .zstd = .{
            .url = "https://github.com/facebook/zstd/archive/refs/tags/v1.5.7.tar.gz",
            .hash = "N-V-__8AAPZ7fwBg4JoCzM_0o2A8wxH2hsUUeiU1iuZv53L5",
            .lazy = true,
        },
        // -Dbrotli: google/brotli 1.2.0, built by build/brotli.zig.
        .brotli = .{
            .url = "https://github.com/google/brotli/archive/refs/tags/v1.2.0.tar.gz",
            .hash = "N-V-__8AAJudKgCQCuIiH6MJjAiIJHfg_tT_Ew-0vZwVkCo_",
            .lazy = true,
        },
        .zlib_zig = .{
            .url = "git+https://github.com/lalinsky/zlib.zig#537dbce25b1b29a0361845b019711dad35699aa6",
            .hash = "zlib-0.1.0-X-kZxmTyEQCJtIUdNRXSe6B4h1r1FGi0GvTcX2pvokom",
            .lazy = true,
        },
        // Until the fork's branch is pushed: a local checkout of it. Then
        // https://github.com/xuckless/nghttp3/archive/<commit>.tar.gz.
        .nghttp3 = .{
            .url = "https://github.com/xuckless/nghttp3/archive/de4bcb905eca28cdfe0e6ef4280b355e1c29660d.tar.gz",
            .hash = "N-V-__8AAEFLFQDX6X1kJVbgLtI2HqUnToQWeqwqMuAlG7Oa",
            .lazy = true,
        },
        .websocket_zig = .{
            .url = "git+https://github.com/xuckless/websocket-zig#065fac7e8b6c53e845335ccccf5a40f435d5ff30",
            .hash = "websocket-0.0.0-UEQdXkQJAgCHF--QcM8bzQIEl_nf38Q0RouBNZuGLh6B",
            .lazy = true,
        },
        .protobuf = .{
            .url = "git+https://github.com/xuckless/zig-protobuf#e6de363eb44854f453280875169d063eb077639e",
            .hash = "protobuf-7.0.0-0e82aujmNgDEMIIEm-NBypMzOKX8l0fZK0gyCpbF1tmE",
            .lazy = true,
        },
        // -Dgrpc: upb, protobuf's C runtime, from the protobuf 36.2 release
        // tarball (BSD-3-Clause): the amalgamation in
        // ruby/ext/google/protobuf_c and third_party/utf8_range, built by
        // build/upb.zig. Only the C ABI's gRPC server links it (JSON <->
        // protobuf from the consumer's descriptors).
        .upb = .{
            .url = "https://github.com/protocolbuffers/protobuf/releases/download/v36.2/protobuf-36.2.tar.gz",
            .hash = "N-V-__8AAPJv3gI7D9QT5MqUNa7RaXBRPTLdOd6eUVgbJ0Nm",
            .lazy = true,
        },
        .yyjson = .{
            .url = "https://github.com/ibireme/yyjson/archive/refs/tags/0.13.0.tar.gz",
            .hash = "N-V-__8AABFlbgB11C3wOoHo9lqDatPMvTuIdHI0vwVxDpTe",
            .lazy = true,
        },
        .hiredis = .{
            .url = "https://github.com/redis/hiredis/archive/refs/tags/v1.5.0.tar.gz",
            .hash = "N-V-__8AAPwwCwC-qD60sHS0_NF1XJZ_qtzgIE_XlRCts2kn",
            .lazy = true,
        },
        .zig_jwt = .{
            .url = "git+https://github.com/xuckless/zig-jwt#243c12861835f546043dd7db0fb33b77b1a16a50",
            .hash = "zig_jwt-1.7.6-w3q9SD1JHwCv7Y7wd9cdliyEaGpggJhl1M9QbZm2oNP6",
            .lazy = true,
        },
        // -Dpostgres: Anole's fork of karlseguin/pg.zig (MIT), branch
        // `anole`: a read timeout, CancelRequest, the automatic statement
        // cache, pool lifetimes, a refused connect's error, TLS through an
        // injected module (Anole's BoringSSL, src/pg/tls.zig), the session
        // reset on release (Pool.Reset: .always or .auto), parameters as a
        // slice of tagged unions and text results (the C ABI), and the
        // bytes the socket accepted (Conn.bytesSent: when a failed call
        // may run again).
        .pg = .{
            .url = "git+https://github.com/xuckless/pg.zig#4abc2caf582dd9965340bd3e4cabcfbb5f74a054",
            .hash = "pg-0.0.0-Wp_7gVtzCQChogRE8uzrNYv1eqywmg0Vc_7aM7sr6sGT",
            .lazy = true,
        },
        // Tests only, fetched only when Anole is the root build: the BSON
        // corpus (source/bson-corpus/tests) of mongodb/specifications. The
        // repository is CC BY-NC-SA 3.0 US, so it is fetched, never vendored
        // or shipped.
        .mongodb_specs = .{
            .url = "https://github.com/mongodb/specifications/archive/7235b61bde1bc75e51f28d8f67dd935198969c02.tar.gz",
            .hash = "N-V-__8AAHq03wFyL3GDg1B5WQRqK98uTOOjLUIriuv5DdbW",
            .lazy = true,
        },
        // SQLite 3.54.1 (public domain), the amalgamation, built by
        // build/sqlite.zig. Published 2026-10-16; sqlite.org's SHA3-256 of the
        // zip: 92281c86e2957f9b9305890f9ac04204caa7b677cc868dc326d942689df28e30.
        .sqlite_amalgamation = .{
            .url = "https://sqlite.org/2026/sqlite-amalgamation-3540100.zip",
            .hash = "N-V-__8AAETTsABEodUZZFAyfdAm9hEyqBXuLw9pRSO0vFh9",
            .lazy = true,
        },
        // vrischmann/zig-sqlite from Anole's fork xuckless/zig-sqlite, branch
        // `anole`: upstream's open Zig 0.17 port (PR #215), bindings through
        // the translate-c package, SQLite taken from the caller (Anole's
        // amalgamation and options header) with no SQLite fetched of its own.
        .zig_sqlite = .{
            .url = "git+https://github.com/xuckless/zig-sqlite#80742c3ce2b1917b44248371e02633cc942a1867",
            .hash = "sqlite-3.54.1-F2R_a_YmBADq3G8bA-jCBgWFcQEaVlxVql4mEN2SbliG",
            .lazy = true,
        },
        // -Dkafka: lz4 1.10.0 (BSD-2, Kafka's most used batch codec), built
        // by build/lz4.zig.
        .lz4 = .{
            .url = "https://github.com/lz4/lz4/archive/refs/tags/v1.10.0.tar.gz",
            .hash = "N-V-__8AAPaNGQD6bmfRjArvYAnsL8DYxbXiNxVE_B6HRpUx",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "examples",
        "tools",
        "templates",
        "tests",
        "LICENSE",
        "THIRD_PARTY_NOTICES",
        "README.md",
    },
}
