.{
    .name = .anole,
    .version = "0.0.0",
    .fingerprint = 0xe9214b117feef58, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Core, always used, pinned by commit. zio: main HEAD on 2026-10-17
        // (its v0.19.x tags are the Zig 0.16 line). dusty: Anole's fork
        // xuckless/dusty, branch `anole`: lalinsky/dusty d3cb485 plus the
        // patches Anole needs. Open upstream (lalinsky/dusty #263-#270): TLS
        // teardown, server ALPN, in-memory PEM, handshake log level, nghttp2
        // injection, HTTP/1.0 keep-alive, the Sink seam and the HTTP/2
        // server engine. Fork-only since: h2c, PROXY protocol, inherited
        // listeners, HTTP/3 seams, TLS close_notify and the rest.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#4e4e1ed10da974f15b119207d346a78cc6c363e4",
            .hash = "zio-0.19.0-xHbVVN3FLABm8N_sLa1zfHWookpE3lCqjjoHw8Xr4GTF",
        },
        .dusty = .{
            .url = "git+https://github.com/xuckless/dusty#a2e194d17a93d167c439b2a19ff919fac5eb8225",
            .hash = "dusty-0.4.0-Qdw7Ri6bKACC4IGIseR23QDeySmrhufOLJCJY4q_zlbD",
        },
        // C bindings generator, branch zig-0.17.x (v2.0.2), pinned by commit.
        .translate_c = .{
            .url = "git+https://codeberg.org/ziglang/translate-c?ref=zig-0.17.x#cfac21f3199b2b02ce3fd7db652aa456421fe4ab",
            .hash = "translate_c-2.0.2-Q_BUWvBNBwDnyehSiuAJmdFcMYHYGA-Jc3KiYdrV2Dqx",
            .lazy = true,
        },
        // -Dhttp2: nghttp2 1.70.0 from Anole's fork xuckless/nghttp2, branch
        // `anole`: the v1.70.0 tag plus its generated nghttp2ver.h and a patch
        // that answers frames on closed streams, PRIORITY errors and stream
        // window overflow as RFC 9113 says (h2spec 146/146).
        .nghttp2 = .{
            .url = "https://github.com/xuckless/nghttp2/archive/0f8bc1c4271f4380409071eade31830e6e436bd6.tar.gz",
            .hash = "N-V-__8AAP98WQBOcqCV-jYjCmw19Aw3aCtmPAMilcMGfLOK",
            .lazy = true,
        },
        // -Dtls=boringssl: google/boringssl at 22a0079b, the commit ngtcp2 1.25.0
        // is tested against, built by build/boringssl.zig.
        .boringssl = .{
            .url = "https://github.com/google/boringssl/archive/22a0079b189c391b95689813a41982ce11876f0a.tar.gz",
            .hash = "N-V-__8AAPOrbw7gV-8XeYfUaBxCqpoXGrn_bb_vyzdnkayq",
            .lazy = true,
        },
        // -Dhttp3: ngtcp2 1.25.0 and nghttp3 1.18.0 release tarballs.
        .ngtcp2 = .{
            .url = "https://github.com/ngtcp2/ngtcp2/releases/download/v1.25.0/ngtcp2-1.25.0.tar.xz",
            .hash = "N-V-__8AADwxaQCTJkOX_hQ27ZB-ox3TiXC3K25GoJCazPOJ",
            .lazy = true,
        },
        // -Dcompression: zlib-ng 2.3.3 (zlib-compat, runtime SIMD dispatch) and
        // zstd 1.5.7, built by build/zlib_ng.zig and build/zstd.zig; and
        // lalinsky/zlib.zig (the commit dusty pins) for its std.Io wrapper,
        // src/root.zig only.
        .zlib_ng = .{
            .url = "https://github.com/zlib-ng/zlib-ng/archive/refs/tags/2.3.3.tar.gz",
            .hash = "N-V-__8AAPaJcABkB6U-96R7h2xuXX5TlDMvwPbE4PucPI59",
            .lazy = true,
        },
        .zstd = .{
            .url = "https://github.com/facebook/zstd/archive/refs/tags/v1.5.7.tar.gz",
            .hash = "N-V-__8AAPZ7fwBg4JoCzM_0o2A8wxH2hsUUeiU1iuZv53L5",
            .lazy = true,
        },
        .zlib_zig = .{
            .url = "git+https://github.com/lalinsky/zlib.zig#537dbce25b1b29a0361845b019711dad35699aa6",
            .hash = "zlib-0.1.0-X-kZxmTyEQCJtIUdNRXSe6B4h1r1FGi0GvTcX2pvokom",
            .lazy = true,
        },
        .nghttp3 = .{
            .url = "https://github.com/ngtcp2/nghttp3/releases/download/v1.18.0/nghttp3-1.18.0.tar.xz",
            .hash = "N-V-__8AACIRMQC5n2gMbQs6uNoXpnY00q7K_3ePaRDb3r0s",
            .lazy = true,
        },
        .websocket_zig = .{
            .url = "git+https://github.com/xuckless/websocket-zig#4bd0e5c4f46466ded5478afb0db3a2f72a264ae8",
            .hash = "websocket-0.0.0-UEQdXjgDAgCbGTdVLwvvGXjiu9jsUWjjxE-ACul9M8HV",
            .lazy = true,
        },
        .protobuf = .{
            .url = "git+https://github.com/Arwalk/zig-protobuf#e9e18c7664b8c950e5fc679259c968dd66ccc48b",
            .hash = "protobuf-7.0.0-0e82aqFhNADVgEgPYPI7ddEg_dzhphBToYgkjQTrMKWv",
            .lazy = true,
        },
        .yyjson = .{
            .url = "https://github.com/ibireme/yyjson/archive/refs/tags/0.13.0.tar.gz",
            .hash = "N-V-__8AABFlbgB11C3wOoHo9lqDatPMvTuIdHI0vwVxDpTe",
            .lazy = true,
        },
        .hiredis = .{
            .url = "https://github.com/redis/hiredis/archive/refs/tags/v1.5.0.tar.gz",
            .hash = "N-V-__8AAPwwCwC-qD60sHS0_NF1XJZ_qtzgIE_XlRCts2kn",
            .lazy = true,
        },
        .zig_jwt = .{
            .url = "git+https://github.com/xuckless/zig-jwt#243c12861835f546043dd7db0fb33b77b1a16a50",
            .hash = "zig_jwt-1.7.6-w3q9SD1JHwCv7Y7wd9cdliyEaGpggJhl1M9QbZm2oNP6",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "examples",
        "tests",
        "LICENSE",
        "THIRD_PARTY_NOTICES",
        "README.md",
    },
}
