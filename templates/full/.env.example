# Settings for development. `anole new` copied this to .env; edit .env freely
# (it is not committed). Anole reads .env only in development (zig build run);
# a release build reads the real environment, where JWT_SECRET must be set.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# SESSION_KEY=            # openssl rand -base64 32
# PORT=3000

# Each line below switches a connector on (its code is in src/main.zig).
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{name}}
# REDIS_URL=redis://127.0.0.1:6379
# NATS_URL=nats://127.0.0.1:4222
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# S3_BUCKET={{name}}                       # with the AWS_* lines below
# AWS_ENDPOINT_URL_S3=http://127.0.0.1:9000  # MinIO, R2...; none: AWS
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SMTP_URL=smtp://127.0.0.1:1025          # Mailpit; smtps://user:pass@host:465 in production
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
