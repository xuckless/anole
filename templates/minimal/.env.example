# Settings for development. `anole new` copied this to .env; edit .env freely
# (it is not committed). Anole reads .env only in development (zig build run);
# a release build reads the real environment.
#
# Your own settings go here too, and `anole.config.load` reads them.
# PORT=3000         # used when ANOLE_DEPLOYMENT=platform (Cloud Run, Fly, Railway)
